# ==============================================================================
# SyllabusSync Environment Configuration
# ==============================================================================

# Supabase Project URL & Anonymous Key
# Obtain these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Remote backend API (for OCR / heavy PDF processing)
# Defaults to in-browser PDF parsing engine if left blank
VITE_API_URL=

# App Name
VITE_APP_NAME=SyllabusSync
